        "\n",
        "def addition(num1, num2):\n",
        "    sum = num1 + num2\n",
        "    return sum\n",
        "\n",
        "def subtraction(num1, num2):\n",
        "    difference = num1 - num2\n",
        "    return difference\n",
        "\n",
        "def multiplication(num1, num2):\n",
        "    product = num1 * num2\n",
        "    return product\n",
        "\n",
        "def division(num1, num2):\n",
        "    quotient = num1 / num2\n",
        "    return quotient\n",
        "\n",
        "\n",
        "num1 = int(input(\"Input first number: \"))\n",
        "num2 = int(input(\"Input second number: \"))\n",
        "\n",
        "#So the program knows what function to use\n",
        "Operation = input(\"Select Operation (addition, subtraction, multiplication, division): \").lower()\n",
        "\n",
        "if Operation == \"addition\":\n",
        "    sum = addition(num1, num2)\n",
        "    print(\"The sum of\", (num1), \"and\", (num2), \"is:\", (sum))\n",
        "\n",
        "elif Operation == \"subtraction\":\n",
        "    difference = subtraction(num1, num2)\n",
        "    print(\"The difference of\", (num1), \"and\", (num2), \"is:\", (difference))\n",
        "\n",
        "elif Operation == \"multiplication\":\n",
        "    product = multiplication(num1, num2)\n",
        "    print(\"The product of\", (num1), \"and\", (num2), \"is:\", (product))\n",
        "\n",
        "elif Operation == \"division\":\n",
        "    if num2 != 0:\n",
        "        quotient = division(num1, num2)\n",
        "        print(\"The quotient of\", (num1), \"and\", (num2), \"is:\", (quotient))\n",
        "\n",
        "\n",
        "#In case the operation wasn't any of the listed ones.\n",
        "else:\n",
        "    print(\"Invalid operation.\")\n"
